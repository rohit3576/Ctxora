# ── Metadata store (sessions, history, knowledge, feedback, vectors) ──────
# 5433 = the host port docker-compose.yml publishes (5432 stays free for
# other local stacks; the container itself still listens on 5432).
METADATA_DB_HOST=localhost
METADATA_DB_PORT=5433
METADATA_DB_NAME=ctxora
METADATA_DB_USER=ctxora
METADATA_DB_PASSWORD=changeme

# ── Telemetry store (credentials; engine choice lives in defaults.yaml) ───
# ClickHouse HTTP port by default; 5432 when adapter: postgres
TELEMETRY_DB_HOST=localhost
TELEMETRY_DB_PORT=8123
TELEMETRY_DB_NAME=ctxora
TELEMETRY_DB_USER=readonly_user
TELEMETRY_DB_PASSWORD=changeme

# ── LLM ───────────────────────────────────────────────────────────────────
# Simplest: set LLM_API_KEY only — everything else stays OpenAI defaults.
# Other provider: set LLM_PROVIDER too; endpoint/models/dimensions derive
# from the preset (any explicit LLM_* var below still overrides it).
# Known providers: openai, gemini
LLM_API_KEY=
LLM_PROVIDER=openai

# ── Overrides (rarely needed; presets already fill these) ─────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── Admin surface ──────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FEEDBACK_ADMIN_TOKEN=
